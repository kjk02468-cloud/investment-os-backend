# ---- 필수 ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ---- 모델/검색 (선택) ----
MODEL=claude-sonnet-4-6
# 동적 필터링 최신 버전. 구버전 폴백: web_search_20250305
WEB_SEARCH_TOOL=web_search_20260209
WEB_SEARCH_MAX_USES=6
MAX_TOKENS=1500
# 감사(critic) 패스를 더 강한 모델로: 예) claude-opus-4-8
EVAL_MODEL=claude-sonnet-4-6

# ---- 텔레그램 알림 (선택, 비우면 알림 끔) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- CORS: 대시보드 호스트 (쉼표 구분). 로컬 테스트는 * ----
ALLOWED_ORIGINS=https://your-dashboard-host
